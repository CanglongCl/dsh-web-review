{
  "name": "@canglongcl/dsh-web-review",
  "description": "DSH web review plugin: page preview, element annotation, visual adjustments, and AI-driven workspace source edits",
  "version": "0.0.4-rc.3",
  "private": true,
  "publishConfig": {
    "access": "restricted",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dsh-external/dsh-web-review.git"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-command",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "tsdown",
    "watch": "tsdown --watch"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1-rc.1",
    "@deepseek-ai/cordis-plugin-include": "1.0.5-rc.1",
    "@deepseek-ai/cordis-plugin-loader": "1.0.1-rc.1",
    "@deepseek-ai/dsh-agent": "0.0.1-rc.1",
    "@deepseek-ai/dsh-client-locale": "0.0.1-rc.1",
    "@deepseek-ai/dsh-client-runtime": "0.0.1-rc.1",
    "@deepseek-ai/dsh-client-ui-command": "0.0.1-rc.1",
    "@deepseek-ai/dsh-client-ui-conversation": "0.0.1-rc.1",
    "@deepseek-ai/dsh-client-ui-layout": "0.0.1-rc.1",
    "@deepseek-ai/dsh-client-ui-primitives": "0.0.1-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "0.0.1-rc.1",
    "@deepseek-ai/dsh-host-webserver": "0.0.1-rc.1",
    "@deepseek-ai/dsh-llm": "0.0.1-rc.1",
    "@deepseek-ai/dsh-session": "0.0.1-rc.1",
    "@deepseek-ai/dsh-skill": "0.0.1-rc.1",
    "@deepseek-ai/dsh-system-prompt": "0.0.1-rc.1",
    "@deepseek-ai/schemastery": "3.18.1-rc.1",
    "@types/react": "~18.3.1",
    "clsx": "^2.0.0",
    "lightningcss": "^1.32.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "typescript": "^6.0.0",
    "@deepseek-ai/dsh-client-ui-settings-general": "0.0.1-rc.1"
  },
  "dependencies": {
    "css-selector-generator": "^3.9.2",
    "parse5": "^7.3.0"
  }
}
