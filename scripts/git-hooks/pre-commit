#!/usr/bin/env bash
# Pre-commit gate (installed via core.hooksPath — see scripts/git-hooks/README).
# Runs the fast quality gate on staged work: typecheck + unit tests + config
# consistency. The full gate (`pnpm check`) stays available for deeper runs.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

echo "[pre-commit] fast repository gate"
pnpm check --fast

echo "[pre-commit] ok"
